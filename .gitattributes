# 源代码和配置文件统一使用 LF
*.py     text eol=lf
*.sh     text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.xml    text eol=lf
*.toml   text eol=lf
*.cfg    text eol=lf

# 文档文件统一使用 LF
*.md     text eol=lf
*.txt    text eol=lf
*.rst    text eol=lf

# Windows 批处理文件使用 CRLF
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# 图片等二进制文件不转换
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pth    binary
*.pt     binary
*.onnx   binary
